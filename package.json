{
	"name": "zodselect",
	"version": "1.2.1",
	"description": "Type-safe selection utility built on top of Zod. Allows for strongly typed field selection, schema merging, and runtime refinement for frontend or backend use.",
	"author": "SecureDataSystems",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/temelyos/zod-select.git"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"./dist",
		"package.json",
		"LICENSE",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "node scripts/build.mjs && tsc --project tsconfig.build.json",
		"clean": "node scripts/clean.mjs",
		"deploy": "npm run build && node ./scripts/publish.mjs",
		"lint": "eslint . --c eslint.config.mjs",
		"lint:fix": "eslint . --c eslint.config.mjs --fix",
		"prune": "node scripts/prune.mjs",
		"test": "tsx --tsconfig ./tsconfig.build.json --test ./src/**/*.{spec,test}.ts ./test/**/*.{spec,test}.ts"
	},
	"devDependencies": {
		"@temelyos/eslint-config": "^1.0.38",
		"@temelyos/tsconfig": "^1.0.6",
		"@types/node": "^26.1.1",
		"tsx": "^4.23.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-native": "npm:typescript@^7.0.2"
	},
	"dependencies": {
		"zod": "^4.4.3"
	}
}
